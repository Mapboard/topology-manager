# Right now, the only way to configure the application is through environment variables.
# This will change soon as we establish more configuration options.

MAPBOARD_DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<database>
MAPBOARD_DATA_SCHEMA=mapboard
MAPBOARD_TOPO_SCHEMA=map_topology
MAPBOARD_SRID=32612
MAPBOARD_TOPO_TOLERANCE=0.1
# How dirty faces are persisted: 'move' primitives between existing map faces (default) or 'replace' faces
MAPBOARD_FACE_UPDATE_MODE=move

TOPO_TESTING_DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<test-database>